{
  "name": "reon-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "REON Energies Pvt Ltd - Monorepo",
  "scripts": {
    "dev:web": "cd apps/web && npm run dev",
    "dev:pos": "cd apps/pos && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:api": "cd server && node index.js",
    "build:web": "cd apps/web && npm run build",
    "build:pos": "cd apps/pos && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "install:all": "cd apps/web && npm install && cd ../pos && npm install && cd ../admin && npm install && cd ../../server && npm install"
  }
}
