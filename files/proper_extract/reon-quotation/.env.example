# reon-quotation/.env  (copy to project root, never commit to git)
# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reonenergy
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ── API ───────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL=https://reonenergy.in

# ── PDF storage ───────────────────────────────────────────────
# Absolute path where generated PDFs are stored on the server
PDF_OUTPUT_DIR=/var/www/reonenergy/generated_pdfs
