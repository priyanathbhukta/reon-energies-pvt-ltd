{
  "name": "reon-quotation-module",
  "version": "1.0.0",
  "description": "Solar quotation PDF generator for REON Energies — plugs into any Express + Postgres app",
  "main": "backend/app.js",
  "scripts": {
    "start":    "node backend/app.js",
    "dev":      "nodemon backend/app.js",
    "db:setup": "psql -U $DB_USER -d $DB_NAME -f backend/db/schema.sql"
  },
  "dependencies": {
    "cors":       "^2.8.5",
    "dotenv":     "^16.4.5",
    "express":    "^4.19.2",
    "pg":         "^8.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
