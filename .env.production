# ── Production API URL ────────────────────────────────────────────────────────
# This file is committed to show the REQUIRED env var name for Vercel.
# Set VITE_API_URL in your Vercel dashboard → Project Settings → Environment Variables.
# DO NOT hardcode the actual URL here if it contains secrets.
#
# Example value: https://reon-energies-pvt-ltd.onrender.com
VITE_API_URL=https://reon-energies-pvt-ltd.onrender.com
